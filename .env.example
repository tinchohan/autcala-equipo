# Lo que es de cada equipo. El instalador lo copia a .env, que no entra al
# repositorio, y `./instalar.sh --configurar` lo completa preguntando.

# El local, como figura en el panel (la parte final de la dirección de su caja):
#   https://dashboard.autcala.com/comercios/caja/ESTE-ID
LOCAL_ID=
# El PIN de la caja de ese local. Si se cambia en el panel, cambiarlo acá.
PIN=
# El horario del local, para avisar si se ve a alguien con el local cerrado.
# Hora argentina, HH:MM. Puede cerrar pasada la medianoche. Vacío: no avisa.
ABRE=07:00
CIERRA=00:30
# Cuántos segundos tiene que estar una persona en la zona `caja` (sumando si
# sale y vuelve) para contar como cliente en la caja. Filtra al que pasa de
# largo y a la gente de la vereda si la zona llega al vidrio.
CAJA_MIN_S=30

# El usuario y la clave de las cámaras o del grabador.
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=

# Un grabador con varias cámaras (sólo en el local, no con el clip de prueba).
FRIGATE_NVR_IP=
FRIGATE_NVR_PUERTO=554

# O una cámara sola con RTSP (una Tapo, etc.): su IP, el puerto del video y la
# ruta del stream. El usuario y la clave son los de arriba. Lo setea
# ./instalar.sh --camara
FRIGATE_CAMARA_IP=
FRIGATE_CAMARA_PUERTO=554
FRIGATE_CAMARA_RUTA=/stream1

# Qué partes del equipo se levantan. «camaras» = Frigate, el correo interno y
# el puente (hace falta el AI HAT+). Vacío = sólo el oído. Lo pone el instalador.
COMPOSE_PROFILES=camaras

# EL OÍDO: el audio del local al oído del servidor, como la tablet del
# mostrador. OIDO=si lo prende (./instalar.sh --oido lo deja listo con un
# micrófono USB). No conviene que escuchen la tablet y el equipo a la vez sin
# puestos: los tramos de los dos se mezclarían.
OIDO=no
# De dónde sale el audio: "usb" (un micrófono USB enchufado a la Pi), "rtsp"
# (el audio de la cámara) o "mic" (el micrófono de una PC Windows).
OIDO_FUENTE=rtsp
# Con "usb": vacío = el primer micrófono USB que encuentre; o uno en
# particular, como plughw:CARD=Device,DEV=0 (la lista: arecord -l).
# Con "mic": el nombre del micrófono (ffmpeg -hide_banner -list_devices true -f dshow -i dummy).
OIDO_MIC=
# Con "rtsp": el canal del audio de la cámara (en una Tapo, /stream1).
OIDO_RUTA=/stream1
# Cómo se corta en tramos: "corrido" (todo, en tramos de 45 s, como la tablet;
# lo de fábrica con el micrófono USB) o "voz" (sólo lo que suena a voz; lo de
# fábrica con la cámara). Vacío = lo de fábrica.
OIDO_MODO=
# Con "voz": cuánto silencio cierra un tramo y cuánto se guarda de antes de la
# primera voz, en milisegundos. Vacío = 700 y 240. Con 2000 y 500 una pausa
# entre dos frases no corta la charla y se dejan afuera sólo los ratos callados.
OIDO_SILENCIO_MS=
OIDO_PREROLL_MS=
# Con "voz": además de sonar a voz, el audio tiene que estar esta cantidad de
# decibeles por encima del ruido de fondo del último minuto. Deja afuera la
# música y las charlas lejanas. Vacío = sin puerta; 14 es un buen comienzo.
OIDO_PUERTA_DB=
# Cuánto se amplifica como mucho. Vacío = según la sensibilidad del panel del
# dueño (×24 Máxima, ×12 Alta, ×6 Normal), como la tablet. Un número lo fija.
OIDO_GANANCIA=
# En un local con varios equipos que escuchan, el puesto de este (el número que
# da el panel). Vacío con un solo equipo.
OIDO_PUESTO=
# Limpieza de ruido del audio antes de transcribir (experimental, para A/B).
# Vacío o "no" = sin tocar. "si" = un filtro razonable para un local ruidoso.
# También acepta un filtro de ffmpeg a medida. Ayuda cuando la voz está tapada
# por ruido; no recupera una voz que llegó demasiado débil.
OIDO_DENOISE=no
# La cadena de audio. Vacío o "natural" = el audio como viene, amplificado.
# "navegador" = con la misma limpieza que le pone un navegador al micrófono
# (filtro de ruido y ganancia automática). "turnos" = media hora cada una, para
# comparar las dos contra los tickets.
OIDO_CADENA=

# Para probar en casa con un clip: MANDAR=no. El puente cuenta y lo escribe en su
# registro, pero no manda nada (y no hacen falta LOCAL_ID ni PIN). En el local: si.
MANDAR=no

# Adónde manda. No tocar.
API=https://api-bis.autcala.com/api/v1
