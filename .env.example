# Lo que es de cada equipo. El instalador lo copia a .env, que no entra al
# repositorio, y `./instalar.sh --configurar` lo completa preguntando.

# El local, como figura en el panel (la parte final de la dirección de su caja):
#   https://dashboard.autcala.com/comercios/caja/ESTE-ID
LOCAL_ID=
# El PIN de la caja de ese local. Si se cambia en el panel, cambiarlo acá.
PIN=
# El horario del local, para avisar si se ve a alguien con el local cerrado.
# Hora argentina, HH:MM. Puede cerrar pasada la medianoche. Vacío: no avisa.
ABRE=07:00
CIERRA=00:30

# El grabador de las cámaras (sólo hace falta en el local, no con el clip de prueba).
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=
FRIGATE_NVR_IP=

# Para probar en casa con un clip: MANDAR=no. El puente cuenta y lo escribe en su
# registro, pero no manda nada (y no hacen falta LOCAL_ID ni PIN). En el local: si.
MANDAR=no

# Adónde manda. No tocar.
API=https://api-bis.autcala.com/api/v1
